# Zeus — Docker Compose environment
# Copy this file to .env and adjust as needed.
# Never commit .env with real passwords to source control.

# ERPNext site name — must match the Host header used to access the app.
# Default 'localhost' works out of the box with http://localhost:8000
SITE_NAME=localhost

# MariaDB root password (used by both the db container and bench new-site)
DB_ROOT_PASSWORD=root_password

# ERPNext Administrator password (set during site creation)
ADMIN_PASSWORD=admin
